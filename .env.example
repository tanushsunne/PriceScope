# SerpApi Key for Google Shopping API
# Get your free API key with 100 free searches/month at https://serpapi.com
# For Render: Add this key under Render Dashboard -> Web Service -> Environment Variables
SERPAPI_KEY="your_serpapi_key_here"

# GEMINI_API_KEY: Required for Gemini AI real-time price estimation
# Get your free key at https://aistudio.google.com/app/apikey
# For Render: Add this key under Render Dashboard -> Web Service -> Environment Variables
# Note: If omitted, the app uses the built-in Indian Tech Catalog as an automatic safeguard.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
